> ///
>         "], qme " %5.3f cond(e(at_vertex) == 1, e(vertex), e(qme)) ///
>         cond(e(at_vertex) == 1, " (vertex)", "") ", z of D " %5.2f e(disc_z)
  9.     display "    J of pgmm " %5.1f e(J_pgmm) " (p " %6.4f e(p_pgmm) ///
>         "), J of gmm " %5.1f e(J_gmm) " (p " %6.4f e(p_gmm) ")"
 10. }
